        "  bin_width = (global_max - global_min) / 1000\n",
        "  bins = np.arange(global_min, global_max + bin_width, bin_width)\n",
        "  plt.hist(series_phase_1, bins=bins, density=False, alpha=0.6, label='MPT')\n",
        "  plt.hist(series_phase_2, bins=bins, density=False, alpha=0.6, label='GBM')\n",
        "  plt.legend()\n",
        "  plt.title(f' Distributions of {element.upper()} portfolio')\n",
