        "\n",
        "efficient_frontier = (\n",
        "    pd.DataFrame({'a': np.arange(-1,2.01,0.01)})\n",
        "    .assign(\n",
        "        omega=lambda x: x['a'].map(\n",
        "            lambda x: x * omega_efp + (1-x) * omega_mvp\n",
        "        )\n",
        "    )\n",
        "    .assign(\n",
        "        mu=lambda x: x['omega'].map(lambda x: x @ mu),\n",
        "        sigma=lambda x: x['omega'].map(lambda x: np.sqrt(x @ sigma @ x)),\n",
        "        sharpe_ratio=lambda x: (x['mu']-daily_rfr)/x['sigma']\n",
        "    )\n",
        ")\n",
        "efficient_frontier = efficient_frontier.sort_values(by='sharpe_ratio', ascending=False, ignore_index=True)\n",
        "omega_srp = efficient_frontier.iat[0,1]\n",
        "mu_srp = efficient_frontier.iat[0,2]\n",
        "sigma_srp = efficient_frontier.iat[0,3]\n",
        "summary_srp = pd.DataFrame(\n",
        "    {'mu': [mu_srp], 'sigma': [sigma_srp], 'type': ['Most Efficient Portfolio']}\n",
        ")\n",
        "#creating 'most efficient portfolio' based on the portfolio with the highest sharp ratio\n",
        "#.iat() just pulls data from indices, row 0 has the srp, and 3=mu, 4=sigma\n",
        "assets = assets.assign(omega_efp=omega_efp)\n",
        "\n",
        "summaries_MPT = pd.concat([assets, summary_inp, summary_mvp, summary_efp, summary_srp, efficient_frontier], ignore_index=True)\n",
        "\n",
        "summaries_MPT_figure = (\n",
        "    ggplot(summaries_MPT, aes(x='sigma',y='mu'))\n",
