        "#comparison cell\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import scipy.stats as stats\n",
        "import sympy as sp\n",
        "import scipy.special as special\n",
        "from scipy.integrate import quad\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "#now that i have my arithmetic MPT portfolios and the compounding MCM data, i can compare the two  distributions\n",
        "\n",
        "for element in portfolio_types:\n",
        "  series_phase_1 = distribution_comparison_df.at[element, 'phase_1']\n",
        "  series_phase_2 = distribution_comparison_df.at[element, 'phase_2']\n",
        "  global_min = pd.Series([series_phase_1.min(), series_phase_2.min()]).min()\n",
        "  global_max = pd.Series([series_phase_1.max(), series_phase_2.max()]).max()\n",
        "  bin_width = (global_max - global_min) / 1000\n",
        "  bins = np.arange(global_min, global_max + bin_width, bin_width)\n",
        "  plt.hist(series_phase_1, bins=bins, density=False, alpha=0.6, label='phase_1')\n",
        "  plt.hist(series_phase_2, bins=bins, density=False, alpha=0.6, label='phase_2')\n",
        "  plt.legend()\n",
        "  plt.title(f' Distributions of {element} portfolio')\n",
        "  plt.show()\n",
        "\n",
        "def get_kl_test_statistic(series_phase_1: pd.Series, series_phase_2: pd.Series):\n",
        "    global_min = pd.Series([series_phase_1.min(), series_phase_2.min()]).min()\n",
        "    global_max = pd.Series([series_phase_1.max(), series_phase_2.max()]).max()\n",
        "    bin_width = (global_max - global_min) / 1000\n",
        "    bins = np.arange(global_min, global_max + bin_width, bin_width)\n",
        "    counts, bin_edges = np.histogram(series_phase_1, bins=bins)\n",
        "    f1 = counts / np.sum(counts)\n",
        "    f1 = np.where(f1 == 0, 1e-10, f1)\n",
        "    counts, bin_edges = np.histogram(series_phase_2, bins=bins)\n",
        "    f2 = counts / np.sum(counts)\n",
        "    f2 = np.where(f2 == 0, 1e-10, f2)\n",
        "    return np.sum(special.kl_div(f1, f2)) #this function directly computes the KL test statistic\n",
        "print('The following uses GBM as the true distribution (P) and MPT as the approximating distribution (Q)')\n",
        "kl_inp = get_kl_test_statistic(distribution_comparison_df.at['inp', 'phase_2'],distribution_comparison_df.at['inp', 'phase_1'])\n",
        "print(f'The KL Test Statistic of the inp Portfolio is: {kl_inp}')\n",
        "kl_mvp = get_kl_test_statistic(distribution_comparison_df.at['mvp', 'phase_2'], distribution_comparison_df.at['mvp', 'phase_1'])\n",
        "print(f'The KL Test Statistic of the MVP Portfolio is: {kl_mvp}')\n",
        "kl_efp = get_kl_test_statistic(distribution_comparison_df.at['efp', 'phase_2'], distribution_comparison_df.at['efp', 'phase_1'])\n",
        "print(f'The KL Test Statistic of the EFP Portfolio is: {kl_efp}')\n",
        "kl_srp = get_kl_test_statistic(distribution_comparison_df.at['srp', 'phase_2'], distribution_comparison_df.at['srp', 'phase_1'])\n",
