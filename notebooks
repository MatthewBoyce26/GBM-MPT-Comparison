        "    + scale_y_continuous(labels=percent_format())\n",
        "    + labs(x='',y='', title='Minimum-variance portfolio weights')\n",
        "    + theme(legend_position='none')\n",
        ")\n",
        "\n",
        "mu = assets['mu'].values\n",
        "mu_mvp = omega_mvp @ mu\n",
        "sigma_mvp = np.sqrt(omega_mvp @ sigma.values @ omega_mvp)\n",
        "summary_mvp = pd.DataFrame(\n",
        "    {\n",
        "        'mu': [mu_mvp],\n",
        "        'sigma': [sigma_mvp],\n",
        "        'type': ['Minimum-variance Portfolio'],\n",
        "    }\n",
        ")\n",
        "\n",
        "assets = pd.merge(assets, investments[['symbol','initial_value']], on='symbol')\n",
        "assets['omega_inp'] = assets['initial_value']/portfolio_worth\n",
        "omega_inp = assets['omega_inp'].values\n",
        "mu_inp = omega_inp @ mu\n",
        "sigma_inp = np.sqrt(omega_inp @ sigma.values @ omega_inp)\n",
        "summary_inp = pd.DataFrame(\n",
        "    {\n",
        "        'mu': [mu_inp],\n",
        "        'sigma': [sigma_inp],\n",
        "        'type': ['inp Portfolio']\n",
        "    }\n",
        ")\n",
        "\n",
        "mu_bar = assets['mu'].max()\n",
        "\n",
        "C = iota @ sigma_inv @ iota\n",
        "D = iota @ sigma_inv @ mu\n",
        "E = mu @ sigma_inv @ mu\n",
        "lambda_tilde = 2 * (mu_bar - D / C) / (E - (D**2) / C)\n",
        "omega_efp = omega_mvp + (lambda_tilde / 2) * (sigma_inv @ mu - D * omega_mvp)\n",
