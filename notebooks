        "sort_col = 'omega_efp'\n",
        "assets = assets.sort_values(sort_col, ascending=True).reset_index(drop=True)\n",
        "\n",
        "assets['symbol'] = pd.Categorical(\n",
        "    assets['symbol'].astype(str),\n",
