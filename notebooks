        "    + scale_x_continuous(labels=percent_format())\n",
        "    + scale_y_continuous(labels=percent_format())\n",
        "    + labs(\n",
        "        x='Volatility', y='Expected Return', title='Expected Return vs. Volatility in Efficient Frontier'\n",
        "    )\n",
        ")\n",
        "\n",
        "input_data = pd.merge(investments, assets, on='symbol')\n",
        "input_data['omega_srp'] = omega_srp\n",
        "\n",
        "#this data is annualized, to be consistent with my other summary data\n",
        "phase1_summary_data = pd.DataFrame(np.nan, index = portfolio_types, columns = ['mu', 'sigma'])\n",
