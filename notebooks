        "import sys\n",
        "print(sys.version)\n",
        "\n",
        "!pip install -q tidyfinance\n",
        "!pip install -q adjustText\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import tidyfinance as tf\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from plotnine import *\n",
        "from mizani.formatters import percent_format\n",
        "from adjustText import adjust_text\n",
        "\n",
        "portfolio_types = ['inp', 'mvp', 'efp', 'srp']\n",
        "investments = pd.read_csv('Sample Investment Data.csv')\n",
        "\n",
        "#change to whatever file name ur .csv is\n",
        "symbols = investments['symbol'].to_list()\n",
        "portfolio_worth = investments['initial_value'].sum()\n",
        "rfr = float(input('Enter the risk-free rate (decimal of the coupon rate):\\n'))\n",
        "daily_rfr = pow(1+rfr,1/252) - 1\n",
        "graph = input('Do you want graphs of simulations with the summary data? (yes) (no)\\n')\n",
        "images = input('Do you want other summary images? (yes) (no)\\n')\n",
        "\n",
        "prices_daily = tf.download_data(\n",
        "    domain = 'stock_prices',\n",
        "    symbols = symbols,\n",
        "    start_date = '2000-01-01',\n",
        "    end_date = '2025-12-31'\n",
        ")\n",
        "\n",
        "returns_daily = (prices_daily\n",
        "    .assign(\n",
        "        ret = lambda x: x.groupby('symbol')['adjusted_close'].pct_change()\n",
        "    )\n",
        ")\n",
        "\n",
        "assets = (returns_daily\n",
        "    .groupby('symbol', as_index = False)\n",
        "    .agg(\n",
        "        mu = ('ret','mean'),\n",
        "        sigma = ('ret','std')\n",
        "    )\n",
        ")\n",
        "\n",
        "returns_wide = (\n",
        "    returns_daily\n",
        "    .pivot(index='date', columns='symbol', values='ret')\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "sigma = (\n",
        "    returns_wide\n",
        "    .drop(columns=['date'])\n",
        "    .cov()\n",
        ")\n",
        "\n",
        "sigma_long = (\n",
        "    sigma\n",
        "    .reset_index()\n",
        "    .melt(id_vars='symbol', var_name='symbol_b', value_name='value')\n",
        ")\n",
        "\n",
        "sigma_long['symbol_b'] = pd.Categorical(\n",
        "    sigma_long['symbol_b'],\n",
        "    categories=sigma_long['symbol_b'].unique()[::-1],\n",
        "    ordered = True\n",
        ")\n",
        "\n",
        "sigma_figure = (\n",
        "    ggplot(\n",
        "        sigma_long,\n",
        "        aes(x='symbol',y='symbol_b',fill='value')\n",
        "    )\n",
        "    + geom_tile()\n",
        "    + labs(x='',y='',fill='(Co-)Variance', title='Sample Variance-Covariance Matrix')\n",
        "    + scale_fill_continuous(labels=percent_format())\n",
        "    + theme(axis_text_x=element_text(angle=45, hjust=1))\n",
        ")\n",
        "\n",
        "iota = np.ones(sigma.shape[0])\n",
        "sigma_inv = np.linalg.inv(sigma.values)\n",
        "omega_mvp = (sigma_inv @ iota) / (iota @ sigma_inv @ iota)\n",
        "\n",
        "assets = assets.assign(omega_mvp=omega_mvp)\n",
        "\n",
        "assets['symbol'] = pd.Categorical(\n",
        "    assets['symbol'],\n",
        "    categories = assets.sort_values('omega_mvp')['symbol'],\n",
        "    ordered = True\n",
        ")\n",
        "\n",
        "omega_figure = (\n",
        "    ggplot(\n",
        "        assets, aes(y='omega_mvp', x='symbol', fill='omega_mvp>0')\n",
        "    )\n",
        "    + geom_col()\n",
        "    + coord_flip()\n",
        "    + scale_y_continuous(labels=percent_format())\n",
        "    + labs(x='',y='', title='Minimum-variance portfolio weights')\n",
        "    + theme(legend_position='none')\n",
        ")\n",
        "\n",
        "mu = assets['mu'].values\n",
        "mu_mvp = omega_mvp @ mu\n",
        "sigma_mvp = np.sqrt(omega_mvp @ sigma.values @ omega_mvp)\n",
        "summary_mvp = pd.DataFrame(\n",
        "    {\n",
        "        'mu': [mu_mvp],\n",
        "        'sigma': [sigma_mvp],\n",
        "        'type': ['Minimum-variance Portfolio'],\n",
        "    }\n",
        ")\n",
        "\n",
        "assets = pd.merge(assets, investments[['symbol','initial_value']], on='symbol')\n",
        "assets['omega_inp'] = assets['initial_value']/portfolio_worth\n",
        "omega_inp = assets['omega_inp'].values\n",
        "mu_inp = omega_inp @ mu\n",
        "sigma_inp = np.sqrt(omega_inp @ sigma.values @ omega_inp)\n",
        "summary_inp = pd.DataFrame(\n",
        "    {\n",
        "        'mu': [mu_inp],\n",
        "        'sigma': [sigma_inp],\n",
        "        'type': ['inp Portfolio']\n",
        "    }\n",
        ")\n",
        "\n",
        "mu_bar = assets['mu'].max()\n",
        "\n",
        "C = iota @ sigma_inv @ iota\n",
        "D = iota @ sigma_inv @ mu\n",
        "E = mu @ sigma_inv @ mu\n",
        "lambda_tilde = 2 * (mu_bar - D / C) / (E - (D**2) / C)\n",
        "omega_efp = omega_mvp + (lambda_tilde / 2) * (sigma_inv @ mu - D * omega_mvp)\n",
        "mu_efp = omega_efp @ mu\n",
        "sigma_efp = np.sqrt(omega_efp @ sigma.values @ omega_efp)\n",
        "\n",
        "summary_efp = pd.DataFrame(\n",
        "    {'mu': [mu_efp], 'sigma': [sigma_efp], 'type': ['Efficient Portfolio']}\n",
        ")\n",
        "\n",
        "assets = assets.assign(omega_efp=omega_efp)\n",
        "\n",
        "sort_col = 'omega_efp'\n",
        "assets = assets.sort_values(sort_col, ascending=True).reset_index(drop=True)\n",
        "\n",
        "assets['symbol'] = pd.Categorical(\n",
        "    assets['symbol'].astype(str),\n",
        "    categories = assets['symbol'].astype(str),\n",
        "    ordered = True\n",
        ")\n",
        "\n",
        "omega_figure_efp = (\n",
        "    ggplot(\n",
        "        assets, aes(y=sort_col, x='symbol', fill=f'{sort_col}>0')\n",
        "    )\n",
        "    + geom_col()\n",
        "    + coord_flip()\n",
        "    + scale_y_continuous(labels=percent_format())\n",
        "    + labs(x='',y='', title='Efficient portfolio weights')\n",
        "    + theme(legend_position='none')\n",
        ")\n",
        "\n",
        "# Display the efficient portfolio weights plot\n",
        "omega_figure_efp.show()\n",
        "print('\\nEfficient Portfolio (EFP) weights:')\n",
        "print(assets[['symbol', 'omega_efp']])\n",
        "\n",
        "efficient_frontier = (\n",
        "    pd.DataFrame({'a': np.arange(-1,2.01,0.01)})\n",
        "    .assign(\n",
        "        omega=lambda x: x['a'].map(\n",
        "            lambda x: x * omega_efp + (1-x) * omega_mvp\n",
        "        )\n",
        "    )\n",
        "    .assign(\n",
        "        mu=lambda x: x['omega'].map(lambda x: x @ mu),\n",
        "        sigma=lambda x: x['omega'].map(lambda x: np.sqrt(x @ sigma @ x)),\n",
        "        sharpe_ratio=lambda x: (x['mu']-daily_rfr)/x['sigma']\n",
        "    )\n",
        ")\n",
        "efficient_frontier = efficient_frontier.sort_values(by='sharpe_ratio', ascending=False, ignore_index=True)\n",
        "omega_srp = efficient_frontier.iat[0,1]\n",
        "mu_srp = efficient_frontier.iat[0,2]\n",
        "sigma_srp = efficient_frontier.iat[0,3]\n",
        "summary_srp = pd.DataFrame(\n",
        "    {'mu': [mu_srp], 'sigma': [sigma_srp], 'type': ['Most Efficient Portfolio']}\n",
        ")\n",
        "#creating 'most efficient portfolio' based on the portfolio with the highest sharp ratio\n",
        "#.iat() just pulls data from indices, row 0 has the srp, and 3=mu, 4=sigma\n",
        "assets = assets.assign(omega_efp=omega_efp)\n",
        "\n",
        "summaries_MPT = pd.concat([assets, summary_inp, summary_mvp, summary_efp, summary_srp, efficient_frontier], ignore_index=True)\n",
        "\n",
        "summaries_MPT_figure = (\n",
        "    ggplot(summaries_MPT, aes(x='sigma',y='mu'))\n",
        "    + geom_point(data=summaries_MPT.query('type.isna()'))\n",
        "    + geom_point(data=summaries_MPT.query('type.notna()'),color='#F21A00', size=3)\n",
        "    + geom_label(\n",
        "        aes(label='type'), adjust_text={'arrowprops': {'arrowstyle':'-'}}\n",
        "    )\n",
        "    + scale_x_continuous(labels=percent_format())\n",
        "    + scale_y_continuous(labels=percent_format())\n",
        "    + labs(\n",
        "        x='Volatility', y='Expected Return', title='Expected Return vs. Volatility in Efficient Frontier'\n",
        "    )\n",
        ")\n",
        "\n",
        "input_data = pd.merge(investments, assets, on='symbol')\n",
        "input_data['omega_srp'] = omega_srp\n",
        "\n",
        "#this data is annualized, to be consistent with my other summary data\n",
        "phase1_summary_data = pd.DataFrame(np.nan, index = portfolio_types, columns = ['mu', 'sigma'])\n",
        "phase1_summary_data.at['inp', 'mu'] = mu_inp * 252\n",
        "phase1_summary_data.at['inp', 'sigma'] = sigma_inp * np.sqrt(252)\n",
        "phase1_summary_data.at['mvp', 'mu'] = mu_mvp * 252\n",
        "phase1_summary_data.at['mvp', 'sigma'] = sigma_mvp * np.sqrt(252)\n",
        "phase1_summary_data.at['efp', 'mu'] = mu_efp * 252\n",
        "phase1_summary_data.at['efp', 'sigma'] = sigma_efp * np.sqrt(252)\n",
        "phase1_summary_data.at['srp', 'mu'] = mu_srp * 252\n",
        "phase1_summary_data.at['srp', 'sigma'] = sigma_srp * np.sqrt(252)\n",
        "phase1_summary_data = (phase1_summary_data\n",
        "    .assign(\n",
        "        theoretical_distribution = lambda df: [np.random.normal(loc=df_row['mu'], scale=df_row['sigma'], size=100000) for index, df_row in df.iterrows()]\n",
        "    )\n",
        ")\n",
        "print(phase1_summary_data)\n",
        "distribution_comparison_df = pd.DataFrame(index = portfolio_types)\n",
        "distribution_comparison_df['phase_1'] = phase1_summary_data['theoretical_distribution']"
      ],
