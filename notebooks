        "\n",
        "from plotnine import *\n",
        "from mizani.formatters import percent_format\n",
        "from adjustText import adjust_text\n",
        "\n",
        "portfolio_types = ['inp', 'mvp', 'efp', 'srp']\n",
        "investments = pd.read_csv('Sample Data.csv')\n",
        "#change to whatever file name ur .csv is\n",
        "symbols = investments['symbol'].to_list()\n",
        "portfolio_worth = investments['initial_value'].sum()\n",
        "rfr = float(input('Enter the risk-free rate (decimal of the coupon rate):\\n'))\n",
        "daily_rfr = pow(1+rfr,1/252) - 1\n",
        "graph = input('Do you want graphs of simulations with the summary data? (yes) (no)\\n')\n",
        "images = input('Do you want other summary images? (yes) (no)\\n')\n",
        "\n",
        "prices_daily = tf.download_data(\n",
        "    domain = 'stock_prices',\n",
        "    symbols = symbols,\n",
        "    start_date = '01-01-2000',\n",
        "    end_date = '12-31-2025'\n",
        ")\n",
        "\n",
        "returns_daily = (prices_daily\n",
        "    .assign(\n",
        "        ret = lambda x: x.groupby('symbol')['adjusted_close'].pct_change()\n",
        "    )\n",
        ")\n",
        "\n",
        "assets = (returns_daily\n",
        "    .groupby('symbol', as_index = False)\n",
        "    .agg(\n",
        "        mu = ('ret','mean'),\n",
        "        sigma = ('ret','std')\n",
        "    )\n",
        ")\n",
        "\n",
        "returns_wide = (\n",
        "    returns_daily\n",
        "    .pivot(index='date', columns='symbol', values='ret')\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "sigma = (\n",
        "    returns_wide\n",
        "    .drop(columns=['date'])\n",
        "    .cov()\n",
        ")\n",
        "\n",
        "sigma_long = (\n",
        "    sigma\n",
        "    .reset_index()\n",
        "    .melt(id_vars='symbol', var_name='symbol_b', value_name='value')\n",
        ")\n",
        "\n",
        "sigma_long['symbol_b'] = pd.Categorical(\n",
        "    sigma_long['symbol_b'],\n",
        "    categories=sigma_long['symbol_b'].unique()[::-1],\n",
        "    ordered = True\n",
        ")\n",
        "\n",
        "sigma_figure = (\n",
        "    ggplot(\n",
        "        sigma_long,\n",
        "        aes(x='symbol',y='symbol_b',fill='value')\n",
        "    )\n",
        "    + geom_tile()\n",
        "    + labs(x='',y='',fill='(Co-)Variance', title='Sample Variance-Covariance Matrix')\n",
        "    + scale_fill_continuous(labels=percent_format())\n",
        "    + theme(axis_text_x=element_text(angle=45, hjust=1))\n",
        ")\n",
        "\n",
        "iota = np.ones(sigma.shape[0])\n",
        "sigma_inv = np.linalg.inv(sigma.values)\n",
        "omega_mvp = (sigma_inv @ iota) / (iota @ sigma_inv @ iota)\n",
        "\n",
        "assets = assets.assign(omega_mvp=omega_mvp)\n",
        "\n",
        "assets['symbol'] = pd.Categorical(\n",
        "    assets['symbol'],\n",
        "    categories = assets.sort_values('omega_mvp')['symbol'],\n",
        "    ordered = True\n",
        ")\n",
        "\n",
        "omega_figure = (\n",
