        "#this is phase 2 where i use GBM to make monte carlo simulations with compounding\n",
        "\n",
        "def simulate_gbm(S0, mu, sigma, steps = 252, n_sims=100000):\n",
        "    dt = 1/252\n",
        "    Z = np.random.normal(0, 1, (steps, n_sims))\n",
        "    returns = (mu - (1/2)*sigma**2) * dt + sigma * np.sqrt(dt) * Z\n",
        "    log_paths = np.cumsum(returns, axis = 0)\n",
        "    S = S0 * np.exp(log_paths)\n",
        "\n",
        "    return S\n",
        "\n",
        "simulation_results = {}\n",
        "\n",
        "for index, row in input_data.iterrows():\n",
        "    symbol = row['symbol']\n",
        "    daily_mu = row['mu']\n",
        "    daily_sigma = row['sigma']\n",
        "\n",
        "    annualized_mu = daily_mu * 252\n",
        "    annualized_sigma = daily_sigma * np.sqrt(252)\n",
        "\n",
        "    paths = simulate_gbm(\n",
        "        S0=1, mu=annualized_mu, sigma=annualized_sigma\n",
        "        )\n",
        "    simulation_results[symbol] = paths\n",
        "    if graph == 'yes':\n",
        "      print(f\"\\nSimulated Paths for {symbol}:\")\n",
        "      plt.figure(figsize=(10, 6))\n",
        "      plt.plot(paths[:, :10])\n",
        "      plt.title(f'Simulated Stock Paths for {symbol}')\n",
        "      plt.xlabel('Days')\n",
        "      plt.ylabel('Stock Price')\n",
        "      plt.show()\n",
        "\n",
        "def q05(x):\n",
        "  return x.quantile(0.05)\n",
        "\n",
        "all_results_path = pd.DataFrame()\n",
        "path_ending_ditribution = {}\n",
        "\n",
        "for symbol, paths_data in simulation_results.items():\n",
        "    path_ending_ditribution[symbol] = pd.Series(paths_data[251, 0:99999])\n",
        "    all_results_path[symbol] = path_ending_ditribution[symbol]\n",
        "\n",
        "portfolio_simulated_results = pd.DataFrame()\n",
        "temp_df = pd.DataFrame()\n",
        "summary_MCM = pd.DataFrame(index = portfolio_types)\n",
        "\n",
        "for element in portfolio_types:\n",
        "    input_data[f'omega_{element}'].index = symbols\n",
        "    temp_df = all_results_path * input_data[f'omega_{element}']\n",
        "    portfolio_simulated_results[element] = temp_df.sum(axis = 1) - 1\n",
        "    summary_MCM.at[element, 'mu'] = portfolio_simulated_results[element].mean()\n",
        "    summary_MCM.at[element, 'sigma'] = portfolio_simulated_results[element].std()\n",
        "    summary_MCM.at[element, 'mu_tilde'] = portfolio_simulated_results[element].median()\n",
        "\n",
        "distribution_comparison_df['phase_2'] = [portfolio_simulated_results[element].values for element in portfolio_types]\n",
        "print(summary_MCM)\n",
        "print(portfolio_simulated_results)\n",
        "print(distribution_comparison_df)"
