        "#this is phase 2 where i use GBM to make monte carlo simulations with compounding\n",
        "\n",
        "def simulate_gbm(S0, mu, sigma, steps = 252, n_sims=100000):\n",
        "    dt = 1/252\n",
        "    Z = np.random.normal(0, 1, (steps, n_sims))\n",
        "    returns = (mu - (1/2)*sigma**2) * dt + sigma * np.sqrt(dt) * Z\n",
        "    log_paths = np.cumsum(returns, axis = 0)\n",
        "    S = S0 * np.exp(log_paths)\n",
        "\n",
        "    return S\n",
